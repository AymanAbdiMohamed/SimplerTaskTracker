{
  "name": "simple-task-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "json-server --watch db.json --host 0.0.0.0 --port ${PORT:-3001}",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\" --names \"API,APP\" --prefix-colors \"blue,green\"",
    "start": "json-server --watch db.json --host 0.0.0.0 --port ${PORT:-3001} --static ./dist"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.1.3",
    "tailwindcss": "^3.4.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "json-server": "^0.17.4",
    "postcss": "^8.5.1",
    "vite": "^7.1.7"
  }
}
